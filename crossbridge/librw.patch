+static void
+rgbaFromRGB565(uint8 *out, uint8 *in)
+{
+	uint32 pixel = in[0] | (in[1] << 8);
+	out[0] = ((pixel >> 11) & 31) * 255 / 31;
+	out[1] = ((pixel >> 5) & 63) * 255 / 63;
+	out[2] = (pixel & 31) * 255 / 31;
+	out[3] = 255;
+}
+
+static void
+rgbaFromARGB4444(uint8 *out, uint8 *in)
+{
+	out[0] = (in[1] & 15) * 17;
+	out[1] = (in[0] >> 4) * 17;
+	out[2] = (in[0] & 15) * 17;
+	out[3] = (in[1] >> 4) * 17;
+}
